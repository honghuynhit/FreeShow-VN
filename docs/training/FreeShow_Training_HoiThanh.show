nt-weight:bold;"}, {"value": "Xử lý tình huống: đổi bài đột xuất, tắt màn hình, mất kết nối máy chiếu", "style": "font-family:Arial;font-size:58px;color:#FFFFFF;line-height:1.3em;"}]}, {"align": "text-align: left;", "text": [{"value": "•  ", "style": "font-family:Arial;font-size:58px;color:#C8963E;line-height:1.3em;font-weight:bold;"}, {"value": "Dùng màn hình bục, điều khiển từ xa, đồng hồ, hợp âm cho ban nhạc", "style": "font-family:Arial;font-size:58px;color:#FFFFFF;line-height:1.3em;"}]}], "textFit": "shrinkToFit"}, {"type": "text", "style": "left:120px;top:1000px;width:1680px;height:50px;", "align": "", "lines": [{"align": "text-align: left;", "text": [{"value": "Huấn luyện FreeShow · Hội Thánh", "style": "font-family:Arial;font-size:26px;color:#C9D3E0;line-height:1.3em;"}]}]}]}, "zcuns3w2mj6": {"group": "Đối tượng tham gia", "color": "#C8963E", "settings": {"color": "#1F3A5F"}, "notes": "", "items": [{"type": "text", "style": "left:120px;top:70px;width:1680px;height:130px;", "align": "align-items: flex-end;", "lines": [{"align": "text-align: left;", "text": [{"value": "Đối tượng tham gia", "style": "font-family:Arial;font-size:76px;color:#FFFFFF;line-height:1.3em;font-weight:bold;"}]}], "textFit": "shrinkToFit"}, {"type": "text", "style": "left:120px;top:220px;width:180px;height:8px;background-color:#C8963E;", "align": "", "lines": [{"align": "text-align: left;", "text": [{"value": "", "style": ""}]}]}, {"type": "text", "style": "left:120px;top:270px;width:1680px;height:710px;", "align": "align-items: flex-start;", "lines": [{"align": "text-align: left;", "text": [{"value": "•  ", "style": "font-family:Arial;font-size:58px;color:#C8963E;line-height:1.3em;font-weight:bold;"}, {"value": "Ban trình chiếu / truyền thông, ban âm thanh – ánh sáng", "style": "font-family:Arial;font-size:58px;color:#FFFFFF;line-height:1.3em;"}]}, {"align": "text-align: left;", "text": [{"value": "•  ", "style": "font-family:Arial;font-size:58px;color:#C8963E;line-height:1.3em;font-wei